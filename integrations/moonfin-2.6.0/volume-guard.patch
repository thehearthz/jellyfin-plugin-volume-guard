+import 'package:flutter/material.dart';
+
+import '../../../playback/volume_guard_controller.dart';
+import '../track_selector_dialog.dart';
+
+String volumeGuardModeLabel(VolumeGuardMode mode) => switch (mode) {
+  VolumeGuardMode.off => 'Off',
+  VolumeGuardMode.balanced => 'Balanced',
+  VolumeGuardMode.night => 'Night',
+  VolumeGuardMode.auto => 'Auto',
+};
+
+/// Uses the same focus-restoring, remote-friendly choices as audio tracks.
+Future<void> showVolumeGuardControl(
+  BuildContext context,
+  VolumeGuardController controller, {
+  required bool Function() isCurrent,
+}) async {
+  final selected = await TrackSelectorDialog.show(
+    context,
+    title: 'Volume Guard',
+    selectedIndex: VolumeGuardMode.values.indexOf(controller.mode),
+    options: const [
+      TrackOption(label: 'Off', subtitle: 'Original audio levels'),
+      TrackOption(
+        label: 'Balanced',
+        subtitle: 'Level quiet dialogue and sudden loud sounds',
+      ),
+      TrackOption(
+        label: 'Night',
+        subtitle: 'Stronger leveling for quieter listening',
+      ),
+      TrackOption(label: 'Auto', subtitle: 'Follow your night schedule'),
+    ],
+    footer: AnimatedBuilder(
+      animation: controller,
+      builder: (context, _) => Padding(
+        padding: const EdgeInsets.fromLTRB(24, 12, 24, 8),
+        child: Text(
+          '${controller.statusLabel}\n\n'
+          'Set schedules in Jellyfin Dashboard → Plugins → Volume Guard. '
+          'Processing uses decoded audio; surround passthrough is unavailable.',
+          style: const TextStyle(color: Colors.white70, fontSize: 13),
+        ),
+      ),
+    ),
+  );
+  if (selected != null && context.mounted && isCurrent()) {
+    await controller.setMode(VolumeGuardMode.values[selected]);
+  }
+}
