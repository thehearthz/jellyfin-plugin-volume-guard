@@ -0,0 +1,288 @@
+import 'dart:async';
+
+import 'package:dio/dio.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:moonfin/playback/volume_guard_controller.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:timezone/data/latest.dart' as tzdata;
+
+Map<String, dynamic> _config({
+  String zone = 'America/New_York',
+  List<int> days = const [0, 1, 2, 3, 4, 5, 6],
+  String start = '22:00',
+  String end = '07:00',
+}) => {
+  'timeZoneId': zone,
+  'scheduleEnabled': true,
+  'daytimeMode': 'Balanced',
+  'nightWindows': [
+    {'days': days, 'start': start, 'end': end},
+  ],
+  'balanced': {
+    'targetRmsDb': -20,
+    'maxGainDb': 6,
+    'limiterCeilingDb': -1,
+    'attackMs': 10,
+    'releaseMs': 500,
+  },
+  'night': {
+    'targetRmsDb': -26,
+    'maxGainDb': 9,
+    'limiterCeilingDb': -4,
+    'attackMs': 5,
+    'releaseMs': 800,
+  },
+};
+
+Map<String, dynamic> _policy() => {
+  'schemaVersion': 1,
+  'enabled': true,
+  'effectiveAutoMode': 'Night',
+  'configuration': _config(),
+};
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  setUp(() {
+    SharedPreferences.setMockInitialValues({});
+    tzdata.initializeTimeZones();
+  });
+
+  test('preserves reverse proxy base path', () {
+    expect(
+      VolumeGuardController.policyUri('https://example.com/jellyfin/')
+          .toString(),
+      'https://example.com/jellyfin/VolumeGuard/policy',
+    );
+  });
+
+  test('overnight schedule uses start day and exclusive end', () {
+    final config = _config(zone: 'UTC', days: [5]);
+    bool active(String instant) =>
+        VolumeGuardController.scheduleActive(config, DateTime.parse(instant));
+    expect(active('2026-10-23T21:59:59Z'), false);
+    expect(active('2026-10-23T22:00:00Z'), true);
+    expect(active('2026-10-24T06:59:59Z'), true);
+    expect(active('2026-10-24T07:00:00Z'), false);
+    expect(active('2026-10-24T22:00:00Z'), false);
+  });
+
+  test('same-day schedule and disabled schedule', () {
+    final config = _config(zone: 'UTC', start: '09:00', end: '17:00');
+    expect(
+      VolumeGuardController.scheduleActive(
+        config,
+        DateTime.utc(2026, 10, 23, 9),
+      ),
+      true,
+    );
+    expect(
+      VolumeGuardController.scheduleActive(
+        config,
+        DateTime.utc(2026, 10, 23, 17),
+      ),
+      false,
+    );
+    config['scheduleEnabled'] = false;
+    expect(
+      VolumeGuardController.scheduleActive(
+        config,
+        DateTime.utc(2026, 10, 23, 12),
+      ),
+      false,
+    );
+  });
+
+  test('both repeated DST hours match and spring gap skips naturally', () {
+    final autumn = _config(start: '01:00', end: '02:00');
+    for (final instant in ['2026-11-01T05:30:00Z', '2026-11-01T06:30:00Z']) {
+      expect(
+        VolumeGuardController.scheduleActive(autumn, DateTime.parse(instant)),
+        true,
+      );
+    }
+    expect(
+      VolumeGuardController.scheduleActive(
+        autumn,
+        DateTime.parse('2026-11-01T07:00:00Z'),
+      ),
+      false,
+    );
+    final spring = _config(start: '01:00', end: '03:00');
+    expect(
+      VolumeGuardController.scheduleActive(
+        spring,
+        DateTime.parse('2026-03-08T06:59:00Z'),
+      ),
+      true,
+    );
+    expect(
+      VolumeGuardController.scheduleActive(
+        spring,
+        DateTime.parse('2026-03-08T07:00:00Z'),
+      ),
+      false,
+    );
+  });
+
+  test(
+    'auth header, native profile, cached outage policy and scoped preference',
+    () async {
+      final requests = <RequestOptions>[];
+      var online = true;
+      final dio = Dio()
+        ..interceptors.add(
+          InterceptorsWrapper(
+            onRequest: (options, handler) {
+              requests.add(options);
+              if (online) {
+                handler.resolve(
+                  Response(requestOptions: options, data: _policy()),
+                );
+              } else {
+                handler.reject(DioException(requestOptions: options));
+              }
+            },
+          ),
+        );
+      final profiles = <Map<String, dynamic>>[];
+      VolumeGuardController controller(String user) => VolumeGuardController(
+        serverUrl: 'https://example.com/jellyfin',
+        accessToken: 'test-token',
+        userId: user,
+        deviceId: 'tv1',
+        dio: dio,
+        now: () => DateTime.utc(2026, 10, 24, 3),
+        applyProfile: (profile) async {
+          profiles.add(profile);
+        },
+      );
+      final first = controller('user1');
+      await first.start();
+      expect(requests.single.uri.path, '/jellyfin/VolumeGuard/policy');
+      expect(requests.single.headers['X-Emby-Token'], 'test-token');
+      expect(requests.single.followRedirects, false);
+      expect(first.usingServerPolicy, true);
+      expect(first.effectiveMode, VolumeGuardMode.night);
+      expect(profiles.last['ceilingDb'], -4);
+      await first.setMode(VolumeGuardMode.off);
+      expect(profiles.last['enabled'], false);
+      first.dispose();
+      online = false;
+      final cached = controller('user1');
+      await cached.start();
+      expect(cached.mode, VolumeGuardMode.off);
+      expect(cached.usingServerPolicy, true);
+      expect(cached.statusLabel, contains('cached'));
+      cached.dispose();
+      final other = controller('user2');
+      await other.start();
+      expect(other.mode, VolumeGuardMode.auto);
+      expect(other.usingServerPolicy, false);
+      other.dispose();
+      dio.close();
+    },
+  );
+
+  test('unknown server timezone uses its evaluated mode', () async {
+    final policy = _policy();
+    (policy['configuration'] as Map)['timeZoneId'] = 'Custom Windows Zone';
+    policy['effectiveAutoMode'] = 'Off';
+    final dio = Dio()
+      ..interceptors.add(
+        InterceptorsWrapper(
+          onRequest: (options, handler) {
+            handler.resolve(Response(requestOptions: options, data: policy));
+          },
+        ),
+      );
+    final controller = VolumeGuardController(
+      serverUrl: 'https://example.com',
+      accessToken: 'token',
+      userId: 'user',
+      deviceId: 'tv',
+      dio: dio,
+      applyProfile: (_) async {},
+    );
+    await controller.start();
+    expect(controller.effectiveMode, VolumeGuardMode.off);
+    controller.dispose();
+    dio.close();
+  });
+
+  test(
+    'server default applies until a local override; master disable wins',
+    () async {
+      final policy = _policy()..['defaultMode'] = 'Night';
+      final dio = Dio()
+        ..interceptors.add(
+          InterceptorsWrapper(
+            onRequest: (options, handler) {
+              handler.resolve(Response(requestOptions: options, data: policy));
+            },
+          ),
+        );
+      final profiles = <Map<String, dynamic>>[];
+      final controller = VolumeGuardController(
+        serverUrl: 'https://example.com',
+        accessToken: 'token',
+        userId: 'user',
+        deviceId: 'tv',
+        dio: dio,
+        applyProfile: (profile) async {
+          profiles.add(profile);
+        },
+      );
+      await controller.start();
+      expect(controller.mode, VolumeGuardMode.night);
+      await controller.setMode(VolumeGuardMode.balanced);
+      await controller.refreshPolicy();
+      expect(controller.mode, VolumeGuardMode.balanced);
+      policy['enabled'] = false;
+      await controller.refreshPolicy();
+      expect(controller.effectiveMode, VolumeGuardMode.off);
+      expect(profiles.last['enabled'], false);
+      policy['enabled'] = true;
+      (policy['configuration'] as Map)['enabled'] = false;
+      await controller.refreshPolicy();
+      expect(controller.effectiveMode, VolumeGuardMode.off);
+      controller.dispose();
+      dio.close();
+    },
+  );
+
+  test('late network result cannot apply after disposal', () async {
+    final pending = Completer<void>();
+    RequestInterceptorHandler? handler;
+    RequestOptions? request;
+    final dio = Dio()
+      ..interceptors.add(
+        InterceptorsWrapper(
+          onRequest: (options, h) {
+            handler = h;
+            request = options;
+            pending.complete();
+          },
+        ),
+      );
+    var applies = 0;
+    final controller = VolumeGuardController(
+      serverUrl: 'https://example.com',
+      accessToken: 'token',
+      userId: 'user',
+      deviceId: 'tv',
+      dio: dio,
+      applyProfile: (_) async {
+        applies++;
+      },
+    );
+    final start = controller.start();
+    await pending.future;
+    controller.dispose();
+    final before = applies;
+    handler!.resolve(Response(requestOptions: request!, data: _policy()));
+    await start;
+    expect(applies, before);
+    dio.close();
+  });
+}
