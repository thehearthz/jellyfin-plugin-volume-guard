diff --git a/lib/playback/volume_guard_controller.dart b/lib/playback/volume_guard_controller.dart
new file mode 100644
index 0000000..78eae06
--- /dev/null
+++ b/lib/playback/volume_guard_controller.dart
@@ -0,0 +1,334 @@
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:crypto/crypto.dart';
+import 'package:dio/dio.dart';
+import 'package:flutter/foundation.dart';
+import 'package:server_core/server_core.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+import 'package:timezone/data/latest.dart' as tzdata;
+import 'package:timezone/timezone.dart' as tz;
+
+enum VolumeGuardMode { off, balanced, night, auto }
+
+/// Device-side policy. The server supplies settings; decoded PCM is processed
+/// on this player, including Direct Play and Live TV.
+class VolumeGuardController extends ChangeNotifier {
+  VolumeGuardController({
+    required String serverUrl,
+    required String accessToken,
+    required String userId,
+    required String deviceId,
+    required Future<void> Function(Map<String, dynamic>) applyProfile,
+    Dio? dio,
+    DateTime Function()? now,
+  }) : _serverUrl = serverUrl.replaceAll(RegExp(r'/+$'), ''),
+       // Keep named constructor arguments public while credentials stay private.
+       // ignore: prefer_initializing_formals
+       _accessToken = accessToken,
+       _scope = sha256
+           .convert(
+             utf8.encode(
+               jsonEncode([
+                 serverUrl.replaceAll(RegExp(r'/+$'), ''),
+                 userId,
+                 deviceId,
+               ]),
+             ),
+           )
+           .toString(),
+       // ignore: prefer_initializing_formals
+       _applyProfile = applyProfile,
+       _dio =
+           dio ??
+           Dio(
+             BaseOptions(
+               connectTimeout: const Duration(seconds: 5),
+               receiveTimeout: const Duration(seconds: 8),
+             ),
+           ),
+       _ownsDio = dio == null,
+       _now = now ?? DateTime.now {
+    if (_ownsDio) configureServerDio(_dio);
+  }
+
+  final String _serverUrl;
+  final String _accessToken;
+  final String _scope;
+  final Dio _dio;
+  final bool _ownsDio;
+  final DateTime Function() _now;
+  final Future<void> Function(Map<String, dynamic>) _applyProfile;
+  SharedPreferences? _preferences;
+  Map<String, dynamic>? _policy;
+  Timer? _refreshTimer;
+  Timer? _scheduleTimer;
+  bool _disposed = false;
+  bool _started = false;
+  bool _fetching = false;
+  bool _serverReachable = false;
+  bool _hasSavedMode = false;
+  VolumeGuardMode _mode = VolumeGuardMode.auto;
+  VolumeGuardMode _effectiveMode = VolumeGuardMode.off;
+  Map<String, dynamic>? _lastProfile;
+  Future<void> _pendingApply = Future<void>.value();
+
+  VolumeGuardMode get mode => _mode;
+  VolumeGuardMode get effectiveMode => _effectiveMode;
+  bool get usingServerPolicy => _policy != null;
+  String get statusLabel =>
+      '${_effectiveMode.name} · ${_policy == null
+          ? 'local schedule'
+          : _serverReachable
+          ? 'server schedule'
+          : 'cached server schedule'}';
+  String get _modeKey => 'volumeGuard.mode.$_scope';
+  String get _policyKey => 'volumeGuard.policy.$_scope';
+
+  Future<void> start() async {
+    if (_started || _disposed) return;
+    _started = true;
+    tzdata.initializeTimeZones();
+    _preferences = await SharedPreferences.getInstance();
+    if (_disposed) return;
+    final savedMode = _preferences!.getString(_modeKey);
+    _hasSavedMode = savedMode != null;
+    final cached = _preferences!.getString(_policyKey);
+    if (cached != null) {
+      try {
+        _policy = _validatedPolicy(jsonDecode(cached));
+      } catch (_) {}
+    }
+    _mode = _parseMode(
+      savedMode ?? _policy?['defaultMode'],
+      VolumeGuardMode.auto,
+    );
+    await _evaluate();
+    if (_disposed) return;
+    _scheduleTimer = Timer.periodic(const Duration(seconds: 15), (_) {
+      unawaited(_evaluate());
+    });
+    _refreshTimer = Timer.periodic(const Duration(seconds: 60), (_) {
+      unawaited(refreshPolicy());
+    });
+    await refreshPolicy();
+  }
+
+  Future<void> setMode(VolumeGuardMode mode) async {
+    if (_disposed) return;
+    _hasSavedMode = true;
+    _mode = mode;
+    await _evaluate();
+    await _preferences?.setString(_modeKey, mode.name);
+  }
+
+  /// Keep the base path of reverse-proxy installations such as /jellyfin.
+  @visibleForTesting
+  static Uri policyUri(String baseUrl) {
+    final base = Uri.parse(baseUrl);
+    return Uri(
+      scheme: base.scheme,
+      host: base.host,
+      port: base.hasPort ? base.port : null,
+      path: '${base.path.replaceAll(RegExp(r'/+$'), '')}/VolumeGuard/policy',
+    );
+  }
+
+  Future<void> refreshPolicy() async {
+    if (_disposed || _fetching || _accessToken.isEmpty) return;
+    _fetching = true;
+    try {
+      final response = await _dio.getUri<dynamic>(
+        policyUri(_serverUrl),
+        options: Options(
+          headers: {'X-Emby-Token': _accessToken},
+          followRedirects: false,
+          responseType: ResponseType.json,
+        ),
+      );
+      final policy = _validatedPolicy(response.data);
+      if (_disposed) return;
+      _policy = policy;
+      if (!_hasSavedMode) {
+        _mode = _parseMode(policy['defaultMode'], VolumeGuardMode.auto);
+      }
+      _serverReachable = true;
+      await _preferences?.setString(_policyKey, jsonEncode(policy));
+    } catch (_) {
+      // The plugin is optional. Keep its last valid policy through outages;
+      // never log a response or URL that might contain session credentials.
+      _serverReachable = false;
+    } finally {
+      _fetching = false;
+      if (!_disposed) await _evaluate();
+    }
+  }
+
+  static VolumeGuardMode _parseMode(dynamic value, VolumeGuardMode fallback) {
+    for (final mode in VolumeGuardMode.values) {
+      if (mode.name == value?.toString().toLowerCase()) return mode;
+    }
+    return fallback;
+  }
+
+  static Map<String, dynamic> _validatedPolicy(dynamic value) {
+    if (value is! Map ||
+        value['schemaVersion'] != 1 ||
+        value['enabled'] is! bool ||
+        value['configuration'] is! Map) {
+      throw const FormatException('Unsupported Volume Guard policy');
+    }
+    final policy = Map<String, dynamic>.from(value);
+    final config = Map<String, dynamic>.from(value['configuration'] as Map);
+    _profile(config['balanced'], true);
+    _profile(config['night'], true);
+    if (config['timeZoneId'] is! String ||
+        config['scheduleEnabled'] is! bool ||
+        config['nightWindows'] is! List) {
+      throw const FormatException('Invalid Volume Guard schedule');
+    }
+    for (final window in config['nightWindows'] as List) {
+      if (window is! Map ||
+          window['days'] is! List ||
+          (window['days'] as List).any((d) => d is! int || d < 0 || d > 6) ||
+          _minutes(window['start']) == null ||
+          _minutes(window['end']) == null) {
+        throw const FormatException('Invalid Volume Guard window');
+      }
+    }
+    return policy;
+  }
+
+  static Map<String, dynamic> _profile(dynamic source, bool enabled) {
+    if (source is! Map) throw const FormatException('Invalid audio profile');
+    double read(String key, double min, double max) {
+      final value = source[key];
+      if (value is! num || !value.isFinite || value < min || value > max) {
+        throw const FormatException('Invalid audio profile value');
+      }
+      return value.toDouble();
+    }
+
+    final target = read('targetRmsDb', -40, -6);
+    final ceiling = read('limiterCeilingDb', -20, 0);
+    if (target > ceiling) {
+      throw const FormatException('Invalid audio target');
+    }
+    return {
+      'enabled': enabled,
+      'targetDb': target,
+      'maxGainDb': read('maxGainDb', 0, 24),
+      'ceilingDb': ceiling,
+      'attackMs': read('attackMs', 1, 200),
+      'releaseMs': read('releaseMs', 20, 5000),
+    };
+  }
+
+  static int? _minutes(dynamic value) {
+    if (value is! String || !RegExp(r'^\d{2}:\d{2}$').hasMatch(value)) {
+      return null;
+    }
+    final parts = value.split(':').map(int.parse).toList();
+    if (parts[0] > 23 || parts[1] > 59) return null;
+    return parts[0] * 60 + parts[1];
+  }
+
+  /// Evaluate wall-clock membership from an instant. Both occurrences of the
+  /// repeated autumn hour match; spring-forward gaps never occur. Overnight
+  /// windows belong to their start day; end is exclusive.
+  @visibleForTesting
+  static bool scheduleActive(Map<String, dynamic> config, DateTime instant) {
+    if (config['scheduleEnabled'] != true) return false;
+    final zone = config['timeZoneId'] as String;
+    final local = tz.TZDateTime.from(
+      instant,
+      zone == 'UTC' ? tz.UTC : tz.getLocation(zone),
+    );
+    return _windowsActive(config['nightWindows'] as List, local);
+  }
+
+  static bool _windowsActive(List windows, DateTime local) {
+    final day = local.weekday % 7;
+    final minute = local.hour * 60 + local.minute;
+    return windows.any((dynamic window) {
+      final start = _minutes(window['start'])!;
+      final end = _minutes(window['end'])!;
+      final days = window['days'] as List;
+      return start < end
+          ? days.contains(day) && minute >= start && minute < end
+          : start > end &&
+                ((days.contains(day) && minute >= start) ||
+                    (days.contains((day + 6) % 7) && minute < end));
+    });
+  }
+
+  Future<void> _evaluate() async {
+    if (_disposed) return;
+    final config = _policy?['configuration'] as Map?;
+    var effective = _mode;
+    if (_policy?['enabled'] == false || config?['enabled'] == false) {
+      effective = VolumeGuardMode.off;
+    } else if (effective == VolumeGuardMode.auto) {
+      if (config == null) {
+        final local = _now().toLocal();
+        effective = local.hour >= 22 || local.hour < 7
+            ? VolumeGuardMode.night
+            : VolumeGuardMode.balanced;
+      } else {
+        try {
+          effective = scheduleActive(Map<String, dynamic>.from(config), _now())
+              ? VolumeGuardMode.night
+              : _parseMode(config['daytimeMode'], VolumeGuardMode.balanced);
+        } catch (_) {
+          // Windows-only/custom timezone IDs may not exist in the IANA data.
+          // Preserve the server's evaluated result instead of using UTC.
+          effective = _parseMode(
+            _policy!['effectiveAutoMode'],
+            VolumeGuardMode.balanced,
+          );
+        }
+        if (effective == VolumeGuardMode.auto) {
+          effective = VolumeGuardMode.balanced;
+        }
+      }
+    }
+    _effectiveMode = effective;
+    final night = effective == VolumeGuardMode.night;
+    final profile = config == null
+        ? <String, dynamic>{
+            'enabled': effective != VolumeGuardMode.off,
+            'targetDb': night ? -26.0 : -20.0,
+            'maxGainDb': night ? 9.0 : 6.0,
+            'ceilingDb': night ? -4.0 : -1.0,
+            'attackMs': night ? 5.0 : 10.0,
+            'releaseMs': night ? 800.0 : 500.0,
+          }
+        : _profile(
+            config[night ? 'night' : 'balanced'],
+            effective != VolumeGuardMode.off,
+          );
+    if (!mapEquals(profile, _lastProfile)) {
+      _lastProfile = profile;
+      _pendingApply = _pendingApply
+          .then((_) async {
+            if (!_disposed) await _applyProfile(profile);
+          })
+          .catchError((Object _) {
+            // Retry on the next schedule evaluation after a native view transition.
+            _lastProfile = null;
+          });
+    }
+    notifyListeners();
+    await _pendingApply;
+  }
+
+  @override
+  void dispose() {
+    if (_disposed) return;
+    _disposed = true;
+    _refreshTimer?.cancel();
+    _scheduleTimer?.cancel();
+    if (_ownsDio) _dio.close(force: true);
+    super.dispose();
+  }
+}
